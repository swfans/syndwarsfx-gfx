# *****************************************************************************
#  Graphics assets generation for SyndWarsFX.
# *****************************************************************************
#  @file sprites-fontc12-0.am
#      Automake rules neccessary to build `fontc12-0` mission font sprites.
#      Font b7 - norm_corpo light brown.
#      Detail 1 - 10 px height.
#  @author   Tomasz Lis
#  @par  Copying and copyrights:
#      This program is free software; you can redistribute it and/or modify
#      it under the terms of the GNU General Public License as published by
#      the Free Software Foundation; either version 2 of the License, or
#      (at your option) any later version.
# *****************************************************************************

fontc12_0_files = data/fontc12-0.dat data/fontc12-0.tab

# List of font letters which can be colorized
fontc12_0_chars = \
  0021 0022 0023 0024 0025 0026 0027 0028 0029 002a 002b 002c 002d 002e 002f \
  0030 0031 0032 0033 0034 0035 0036 0037 0038 0039 003a 003b 003c 003d 003e 003f \
  0040 0041 0042 0043 0044 0045 0046 0047 0048 0049 004a 004b 004c 004d 004e 004f \
  0050 0051 0052 0053 0054 0055 0056 0057 0058 0059 005a 005b 005c 005d 005e 005f \
  0060 0061 0062 0063 0064 0065 0066 0067 0068 0069 006a 006b 006c 006d 006e 006f \
  0070 0071 0072 0073 0074 0075 0076 0077 0078 0079 007a 007e \
  00a1 00aa 00b0 00bf 00c0 00c1 00c4 00c5 00c7 00c8 00c9 00cc 00cd \
  00d1 00d2 00d3 00d6 00d9 00da 00dc 00df \
  0104 0106 0118 0141 0143 015a 0179 017b 2018 2019
# List of non-letters or other sprites to pass without colorization
fontc12_0_charnames_nomod = \
  empty char_u0020
fontc12_0_sprites_gen = \
  $(foreach num,$(fontc12_0_chars),font_norm_corpo-5-shd-ltbrown/char_u$(num).png)
fontc12_0_sprites_cp = \
  $(foreach name,$(fontc12_0_charnames_nomod),$(top_srcdir)/font_norm_corpo-5-white/$(name).png)

data/fontc12-0.tab: data/fontc12-0.dat

data/fontc12-0.dat: font_norm_corpo-5-shd-ltbrown/filelist-fontc12-0.txt $(top_srcdir)/data/engine-std.pal $(fontc12_0_sprites_gen)

font_norm_corpo-5-shd-ltbrown/filelist-fontc12-0.txt: $(top_srcdir)/font_norm_corpo-5-white/filelist-fontc11-0.txt
	$(MKDIR_P) "$(@D)"
	cp -p -t "$(@D)" $(fontc12_0_sprites_cp)
	cp -p "$<" "$@"

# Use ImageMagick to generate blue sprites from previously made white shaded ones
# 1. First use `level` to make lack and white sprite,
# 2. `level` single channels to achieve front and shadow colors
font_norm_corpo-5-shd-ltbrown/%.png: font_norm_corpo-5-shd-white/%.png
	$(MKDIR_P) "$(@D)"
	$(MAGICK_CONVERT) "$<" -colorspace RGB \
        -channel RGB -level 30%,90% \
        -channel R +level 5%,75% \
        -channel G +level 26%,17% \
        -channel B +level 5%,17%% \
        +channel \
        -colorspace RGB "png32:$@"
