  ${mspr0_agent_sprites_laying} \
  ${mspr0_agent_sprites_pickup} \
  ${mspr0_agent_sprites_pushback} \
  ${mspr0_agent_sprites_running} \
  ${mspr0_agent_sprites_walk_armr_nowep} \
  ${mspr0_agent_sprites_walk_armr_weplt} \
  ${mspr0_agent_sprites_walk_hand_weplt} \
  ${mspr0_agent_sprites_walk_legs} \
  ${mspr0_agent_sprites_walk_tors_nowep} \
  ${mspr0_agent_sprites_walk_tors_weplt}

