  $(foreach ang,0 1 2 3 4,$(foreach frm,000,agent-grey/pushback_ang$(ang)_f$(frm)))

mspr0_agent_sprites_running = \
  $(foreach ang,0 1 2 3 4,$(foreach frm,000 001 002 003 004 005,agent-grey/running_ang$(ang)_f$(frm)))

mspr0_agent_sprites_walk_armr_nowep = \
