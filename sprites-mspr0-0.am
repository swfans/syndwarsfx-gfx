mspr0_0_files = data/mspr0-0.dat data/mspr0-0.tab

# Sprites representing a person - agent

mspr0_agent_sprites_bloody = \
  $(foreach ang,0 1 2 3 4,$(foreach frm,000,agent-grey/bloody_ang$(ang)_f$(frm)))

mspr0_agent_sprites_fall = \
  $(foreach ang,0 1 3 4,$(foreach frm,000 001 002 003 004,agent-grey/fall_ang$(ang)_f$(frm))) \
  $(foreach ang,2,$(foreach frm,001 002 003 004,agent-grey/fall_ang$(ang)_f$(frm)))

mspr0_agent_sprites_laying = \
  $(foreach ang,1 3,$(foreach frm,000 001,agent-grey/laying_ang$(ang)_f$(frm)))

mspr0_agent_sprites_pickup = \
  $(foreach ang,0 1,$(foreach frm,000 001 002,agent-grey/pickup_ang$(ang)_f$(frm)))

