  $(foreach ang,1 3,$(foreach frm,000 001,punk_f-beige/laying_ang$(ang)_f$(frm)))

mspr0_punk_f_sprites_pickup = \
  $(foreach ang,0 1,$(foreach frm,000 001 002,punk_f-beige/pickup_ang$(ang)_f$(frm)))

mspr0_punk_f_sprites_pushback = \
  $(foreach ang,0 1 2 3 4,$(foreach frm,000,punk_f-beige/pushback_ang$(ang)_f$(frm)))

mspr0_punk_f_sprites_walk_legs = \
  $(foreach ang,0 1 2 3 4,$(foreach frm,000 001 002 003 004 005,punk_f-beige/walk_legs_ang$(ang)_f$(frm)))

mspr0_punk_f_sprites_var = \
  $(foreach frm,348 349 350 351 352 353 354 355 356 357 358 359 360 361 362 363 364 365 366 367 368 369 370 371 372 373 374 375 376 377 378 379 380,punk_f-beige/pic0$(frm))

mspr0_punk_f_sprites = \
  ${mspr0_punk_f_sprites_bloody} \
  ${mspr0_punk_f_sprites_braid_red} \
  ${mspr0_punk_f_sprites_fall} \
  ${mspr0_punk_f_sprites_head_blond} \
  ${mspr0_punk_f_sprites_head_blue} \
  ${mspr0_punk_f_sprites_head_brown} \
  ${mspr0_punk_f_sprites_head_red} \
  ${mspr0_punk_f_sprites_hold_wephv} \
  ${mspr0_punk_f_sprites_laying} \
  ${mspr0_punk_f_sprites_pickup} \
  ${mspr0_punk_f_sprites_pushback} \
  ${mspr0_punk_f_sprites_walk_legs} \
  ${mspr0_punk_f_sprites_var}


# List of sprites to pass without alterations
mspr0_0_sprnames_nomod = \
  ${mspr0_agent_sprites} \
  ${mspr0_punk_f_sprites} \
  empty

mspr0_0_sprites_cp = \
  $(foreach name,$(mspr0_0_sprnames_nomod),engine_sprites-32-baked/$(name).png)

data/mspr0-0.tab: data/mspr0-0.dat

data/mspr0-0.dat: engine_sprites-32-baked/filelist-mspr0-0.txt $(top_srcdir)/data/engine-std.pal ${mspr0_0_sprites_cp}

engine_sprites-32-baked/%.txt: $(top_srcdir)/engine_sprites-32/%.txt
	$(MKDIR_P) "$(@D)"
	cp -p "$<" "$@"

engine_sprites-32-baked/%.png: $(top_srcdir)/engine_sprites-32/%.png
	$(MKDIR_P) "$(@D)"
	cp -p "$<" "$@"

engine_sprites-32-baked/agent-grey/%.png: $(top_srcdir)/engine_sprites-32/agent-grey/%.png
	$(MKDIR_P) "$(@D)"
	cp -p "$<" "$@"
